      "asrStart": 388.58,
      "asrEnd": 390.22,
      "t": 388.58,
      "source": "matched-anchor",
      "needsReview": false
    },
    {
      "line": 91,
      "originalT": 390.6,
      "en": "Sounds fine, Robbie.",
      "coverage": 1.0,
      "asrStart": 391.66,
      "asrEnd": 392.72,
      "t": null,
      "source": "unresolved",
      "needsReview": true
    },
    {
      "line": 92,
      "originalT": 393.6,
      "en": "Well, I saw a nice watch.",
      "coverage": 1.0,
      "asrStart": 393.76,
      "asrEnd": 395.02,
      "t": 393.76,
      "source": "matched-anchor",
      "needsReview": false
    },
    {
      "line": 93,
