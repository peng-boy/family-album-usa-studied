      "originalT": 408.6,
      "en": "When do you need the money?",
      "coverage": 1.0,
      "asrStart": 410.22,
      "asrEnd": 411.24,
      "t": 410.22,
      "source": "matched-anchor",
      "needsReview": false
    },
    {
      "line": 98,
      "originalT": 411.6,
      "en": "Would tomorrow be OK?",
      "coverage": 0.75,
      "asrStart": 412.02,
      "asrEnd": 412.86,
      "t": 413.58,
      "source": "interpolated-review",
      "needsReview": true
    },
    {
