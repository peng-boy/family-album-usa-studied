      "originalT": 385.6,
      "en": "Nothing flashy or expensive.",
      "coverage": 1.0,
      "asrStart": 385.94,
      "asrEnd": 387.6,
      "t": 385.94,
      "source": "matched-anchor",
      "needsReview": false
    },
    {
      "line": 90,
      "originalT": 387.6,
      "en": "Something simple--but a good one.",
