      "en": "Thanks, Dad.",
      "coverage": 1.0,
      "asrStart": 418.12,
      "asrEnd": 418.88,
      "t": null,
      "source": "unresolved",
      "needsReview": true
    },
    {
      "line": 101,
      "originalT": 419.6,
      "en": "My pleasure, Son.",
      "coverage": 1.0,
      "asrStart": 419.86,
      "asrEnd": 420.82,
      "t": null,
      "source": "unresolved",
      "needsReview": true
    },
    {
      "line": 102,
      "originalT": 421.6,
      "en": "Oh, and, Robbie ...",
      "coverage": 1.0,
      "asrStart": 422.36,
      "asrEnd": 423.32,
      "t": null,
      "source": "unresolved",
      "needsReview": true
    },
    {
      "line": 103,
      "originalT": 424.6,
      "en": "Yes?",
      "coverage": 1.0,
      "asrStart": 423.32,
      "asrEnd": 423.86,
      "t": null,
      "source": "unresolved",
      "needsReview": true
    },
    {
      "line": 104,
      "originalT": 425.6,
      "en": "You'll probably want the family car",
      "coverage": 0.857,
      "asrStart": 426.12,
      "asrEnd": 428.24,
      "t": 426.12,
      "source": "matched-anchor",
      "needsReview": false
    },
    {
      "line": 105,
      "originalT": 428.6,
      "en": "so you can drive her home after the party.",
      "coverage": 1.0,
      "asrStart": 428.24,
      "asrEnd": 431.04,
      "t": 428.24,
      "source": "matched-anchor",
      "needsReview": false
    },
    {
      "line": 106,
      "originalT": 431.6,
      "en": "Could I?",
      "coverage": 1.0,
      "asrStart": 431.44,
      "asrEnd": 432.18,
      "t": null,
      "source": "unresolved",
      "needsReview": true
    },
