      "en": "I applied for a job as a lifeguard at the community pool.",
      "coverage": 1.0,
      "asrStart": 347.2,
      "asrEnd": 349.72,
      "t": 347.2,
      "source": "matched-anchor",
      "needsReview": false
    },
    {
      "line": 76,
      "originalT": 349.6,
      "en": "Sounds pretty good.",
      "coverage": 1.0,
      "asrStart": 350.76,
      "asrEnd": 352.14,
      "t": 349.97,
      "source": "interpolated-review",
      "needsReview": true
    },
    {
      "line": 77,
      "originalT": 352.6,
      "en": "Yes. I'll be earning pretty good money if I get it.",
      "coverage": 1.0,
      "asrStart": 352.74,
      "asrEnd": 355.64,
      "t": 352.74,
      "source": "matched-anchor",
      "needsReview": false
    },
    {
      "line": 78,
      "originalT": 355.6,
      "en": "But right now, I'm kind of short of cash.",
      "coverage": 1.0,
      "asrStart": 356.48,
      "asrEnd": 358.4,
      "t": 356.48,
      "source": "matched-anchor",
      "needsReview": false
    },
    {
      "line": 79,
      "originalT": 358.6,
      "en": "Who isn't?",
      "coverage": 0.333,
      "asrStart": 360.7,
      "asrEnd": 361.18,
      "t": null,
      "source": "unresolved",
      "needsReview": true
    },
    {
      "line": 80,
      "originalT": 361.6,
      "en": "And my friend Alexandra is going back to Greece ...",
      "coverage": 0.889,
      "asrStart": 362.48,
      "asrEnd": 365.12,
      "t": null,
      "source": "unresolved",
      "needsReview": true
    },
    {
      "line": 81,
      "originalT": 365.6,
      "en": "Nice girl.",
      "coverage": 1.0,
      "asrStart": 366.3,
      "asrEnd": 366.94,
      "t": null,
      "source": "unresolved",
      "needsReview": true
    },
    {
      "line": 82,
      "originalT": 367.6,
      "en": "We'll all miss her.",
      "coverage": 0.6,
      "asrStart": 367.8,
      "asrEnd": 369.0,
      "t": null,
      "source": "unresolved",
      "needsReview": true
    },
    {
      "line": 83,
      "originalT": 368.6,
      "en": "Mom says we can give her a going-away surprise party.",
      "coverage": 1.0,
      "asrStart": 369.0,
      "asrEnd": 371.84,
      "t": null,
      "source": "unresolved",
      "needsReview": true
    },
    {
      "line": 84,
      "originalT": 372.6,
      "en": "Good idea.",
      "coverage": 1.0,
      "asrStart": 372.78,
      "asrEnd": 373.4,
      "t": null,
      "source": "unresolved",
      "needsReview": true
    },
    {
      "line": 85,
      "originalT": 373.6,
      "en": "And I'd like to get her a nice gift ...",
      "coverage": 1.0,
      "asrStart": 374.32,
      "asrEnd": 375.86,
      "t": 374.32,
      "source": "matched-anchor",
      "needsReview": false
    },
    {
      "line": 86,
      "originalT": 376.6,
      "en": "What'd you have in mind?",
      "coverage": 1.0,
      "asrStart": 378.0,
      "asrEnd": 378.82,
      "t": 378.0,
      "source": "matched-anchor",
      "needsReview": false
    },
    {
      "line": 87,
      "originalT": 378.6,
      "en": "Well, a wristwatch,",
      "coverage": 1.0,
      "asrStart": 379.78,
      "asrEnd": 381.56,
      "t": null,
      "source": "unresolved",
      "needsReview": true
    },
    {
      "line": 88,
      "originalT": 382.2,
      "en": "so she'll think of me when she looks at the time.",
      "coverage": 1.0,
      "asrStart": 382.46,
      "asrEnd": 384.88,
      "t": 382.46,
      "source": "matched-anchor",
      "needsReview": false
    },
    {
