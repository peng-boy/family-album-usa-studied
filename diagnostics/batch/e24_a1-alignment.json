      "en": "But I'll need a loan.",
      "coverage": 1.0,
      "asrStart": 395.52,
      "asrEnd": 397.26,
      "t": 395.52,
      "source": "matched-anchor",
      "needsReview": false
    },
    {
      "line": 94,
      "originalT": 397.6,
      "en": "If you could lend me the money,",
      "coverage": 1.0,
      "asrStart": 397.94,
      "asrEnd": 399.26,
      "t": 397.47,
      "source": "interpolated-review",
      "needsReview": true
    },
    {
      "line": 95,
      "originalT": 399.6,
      "en": "I could pay you back out of my lifeguard salary.",
      "coverage": 1.0,
      "asrStart": 399.42,
      "asrEnd": 401.34,
      "t": 399.42,
      "source": "matched-anchor",
      "needsReview": false
    },
    {
      "line": 96,
      "originalT": 402.6,
      "en": "Well, I guess your mother and I can manage it.",
      "coverage": 1.0,
      "asrStart": 405.7,
      "asrEnd": 408.76,
      "t": 405.7,
      "source": "matched-anchor",
      "needsReview": false
    },
    {
