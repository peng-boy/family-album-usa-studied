      "asrStart": 340.52,
      "asrEnd": 341.02,
      "t": 339.824,
      "source": "interpolated-review",
      "needsReview": true
    },
    {
      "line": 95,
      "originalT": 226.26,
      "en": "But what do you care about?",
      "coverage": 1.0,
      "asrStart": 341.92,
      "asrEnd": 344.08,
      "t": 341.92,
      "source": "matched-anchor",
      "needsReview": false
    },
    {
